REGISTRY_HOST=registry.example.com
REGISTRY_PORT=443
REGISTRY_USERNAME=registry-admin
REGISTRY_PASSWORD=change-this-to-a-long-random-password
REGISTRY_HTTP_SECRET=change-this-to-a-different-long-random-secret

AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1
AWS_S3_BUCKET=private-docker-registry
AWS_S3_ENCRYPT=true
S3_ROOT_DIRECTORY=/registry
