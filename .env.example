# Hostname (and optional port) used by Docker clients and Kubernetes nodes.
# Use a DNS name in production, not localhost.
REGISTRY_HOST=registry.example.com

# Address and port exposed by the registry container.
# For host Nginx/Caddy, use REGISTRY_BIND_ADDRESS=127.0.0.1 and an internal
# port such as 5001. For direct access without a reverse proxy, use 0.0.0.0
# and the public registry port.
REGISTRY_BIND_ADDRESS=0.0.0.0
REGISTRY_PORT=443

# Credentials used by the registry and by scripts/registry.sh login.
REGISTRY_USERNAME=registry-admin
REGISTRY_PASSWORD=change-this-to-a-long-random-password

# Used by the registry to sign sessions. Keep this stable across restarts.
REGISTRY_HTTP_SECRET=change-this-to-a-long-random-secret

# Optional private CA file for the direct self-signed deployment.
# Leave unset when using Caddy with a public Let's Encrypt certificate.
# REGISTRY_CA_FILE=registry/certs/registry.crt

# Optional Prometheus host port. Prometheus binds to localhost only.
PROMETHEUS_PORT=9090

# Optional cron schedule used by: registry backup schedule install
# Five-field cron format; this example runs every day at 02:00 server time.
REGISTRY_BACKUP_SCHEDULE="0 2 * * *"
