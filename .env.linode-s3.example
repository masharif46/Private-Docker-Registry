REGISTRY_HOST=registry.example.com
REGISTRY_PORT=443
REGISTRY_USERNAME=registry-admin
REGISTRY_PASSWORD=change-this-to-a-long-random-password
REGISTRY_HTTP_SECRET=change-this-to-a-different-long-random-secret

LINODE_S3_ACCESS_KEY=change-me
LINODE_S3_SECRET_KEY=change-me
LINODE_S3_REGION=us-east-1
LINODE_S3_BUCKET=private-docker-registry
# Copy the endpoint hostname from Cloud Manager and include https://.
LINODE_S3_ENDPOINT=https://us-east-1.linodeobjects.com
S3_ROOT_DIRECTORY=/registry
